{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "768px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "charcoal", "color": "#1a1a1a", "name": "Charcoal" },
				{ "slug": "charcoal-light", "color": "#2a2a2a", "name": "Charcoal Light" },
				{ "slug": "onyx", "color": "#121110", "name": "Onyx" },
				{ "slug": "gold", "color": "#c9a961", "name": "Gold" },
				{ "slug": "gold-soft", "color": "#d8c08a", "name": "Gold Soft" },
				{ "slug": "gold-bright", "color": "#e4cf9c", "name": "Gold Bright" },
				{ "slug": "ivory", "color": "#f5f1e8", "name": "Ivory" },
				{ "slug": "ivory-dark", "color": "#ece5d5", "name": "Ivory Dark" },
				{ "slug": "muted", "color": "#645c4e", "name": "Muted" },
				{ "slug": "graysoft", "color": "#8e8e8e", "name": "Gray Soft" },
				{ "slug": "terracotta", "color": "#d4a574", "name": "Terracotta" },
				{ "slug": "burgundy", "color": "#8b3a3a", "name": "Burgundy" },
				{ "slug": "white", "color": "#ffffff", "name": "White" }
			],
			"gradients": [
				{ "slug": "gold-text", "gradient": "linear-gradient(135deg, #e4cf9c, #c9a961 55%, #a8843f)", "name": "Gold" },
				{ "slug": "hero-overlay", "gradient": "linear-gradient(to bottom, rgba(18,17,16,.35), rgba(18,17,16,.55) 55%, rgba(18,17,16,.78))", "name": "Hero overlay" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": false,
			"fontFamilies": [
				{ "slug": "serif", "name": "Playfair Display", "fontFamily": "\"Playfair Display\", \"Playfair Display Fallback\", Georgia, serif" },
				{ "slug": "sans", "name": "Inter", "fontFamily": "Inter, \"Inter Fallback\", system-ui, sans-serif" },
				{ "slug": "accent", "name": "Cormorant", "fontFamily": "Cormorant, \"Cormorant Fallback\", Georgia, serif" }
			],
			"fontSizes": [
				{ "slug": "xs", "size": "0.75rem", "name": "XS" },
				{ "slug": "sm", "size": "0.875rem", "name": "Small" },
				{ "slug": "base", "size": "1rem", "name": "Base" },
				{ "slug": "lg", "size": "1.125rem", "name": "Large" },
				{ "slug": "xl", "size": "1.25rem", "name": "XL" },
				{ "slug": "2xl", "size": "1.5rem", "name": "2XL" },
				{ "slug": "3xl", "size": "1.875rem", "name": "3XL" },
				{ "slug": "4xl", "size": "2.25rem", "name": "4XL" },
				{ "slug": "section", "size": "2.75rem", "name": "Section" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "XS" },
				{ "slug": "40", "size": "1rem", "name": "S" },
				{ "slug": "50", "size": "1.5rem", "name": "M" },
				{ "slug": "60", "size": "2.5rem", "name": "L" },
				{ "slug": "70", "size": "4rem", "name": "XL" },
				{ "slug": "80", "size": "6rem", "name": "Section" },
				{ "slug": "90", "size": "8rem", "name": "Section (desktop)" }
			]
		},
		"custom": {
			"ease": { "lux": "cubic-bezier(0.22, 1, 0.36, 1)" },
			"headerHeight": "88px"
		}
	},
	"styles": {
		"color": { "background": "#ffffff", "text": "#1a1a1a" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"lineHeight": "1.7"
		},
		"spacing": { "blockGap": "1.5rem" },
		"elements": {
			"link": {
				"color": { "text": "inherit" },
				"typography": { "textDecoration": "none" }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "400",
					"lineHeight": "1.12",
					"letterSpacing": "-0.015em"
				}
			},
			"button": {
				"border": { "radius": "0" },
				"color": { "background": "#d4a574", "text": "#1a1a1a" },
				"typography": {
					"fontSize": "0.875rem",
					"fontWeight": "500",
					"letterSpacing": "0.15em",
					"textTransform": "uppercase"
				},
				":hover": { "color": { "background": "#c9a961" } }
			}
		}
	}
}
