{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "interior-specifics/stats-band",
	"version": "1.0.0",
	"title": "Stats Band",
	"category": "interior-specifics",
	"icon": "chart-bar",
	"description": "A slim dark band of headline numbers that count up when scrolled into view.",
	"keywords": [ "stats", "numbers", "counter", "proof" ],
	"textdomain": "interior-specifics",
	"supports": {
		"html": false,
		"align": false,
		"anchor": true
	},
	"attributes": {
		"stats": {
			"type": "array",
			"default": [
				{ "value": "15+", "label": "Years of practice" },
				{ "value": "200+", "label": "Projects delivered" },
				{ "value": "12", "label": "In-house disciplines" },
				{ "value": "100%", "label": "Turnkey delivery" }
			],
			"items": { "type": "object" }
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
